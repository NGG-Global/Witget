<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget-picker preview. Static by design: the picker renders this before the
  widget exists, so it shows representative sample values. Colours come from
  per-mode resources so the preview stays readable in dark launchers too.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tile_daily_joke"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="@string/widget_daily_joke_label"
        android:textAllCaps="true"
        android:textColor="@color/preview_ink_daily_joke"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:text="@string/widget_daily_joke_preview_voice"
        android:textColor="@color/preview_ink_daily_joke"
        android:textSize="13sp" />
</LinearLayout>
