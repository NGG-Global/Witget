<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget-picker preview. Deliberately static: the picker renders this before the
  widget exists, so it shows representative sample values rather than live data.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tile_countdown"
    android:orientation="vertical"
    android:padding="15dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="@string/widget_countdown_label"
        android:textAllCaps="true"
        android:textColor="#FFF6EC"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_countdown_preview_hero"
        android:textColor="#FFF6EC"
        android:textSize="34sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:text="@string/widget_countdown_preview_voice"
        android:textColor="#FFF6EC"
        android:textSize="13sp" />
</LinearLayout>
