    <string name="detail_template_note">These settings apply to widgets you add from here. Widgets already on your home screen keep their own.</string>
    <string name="setup_intro_headline">Your phone already has the data. These widgets give it a personality.</string>
    <string name="setup_intro_spec">EIGHT WIDGETS · FIVE VOICES · FOUR PACKS</string>
    <string name="setup_intro_sub">Setup takes about a minute. Nothing you pick leaves the device.</string>
    <string name="setup_step_voice">STEP 01 · VOICE</string>
    <string name="setup_voice_title">Pick a voice</string>
    <string name="setup_voice_sub">Five personalities change what every widget says. You can set one globally and override it per widget.</string>
    <string name="setup_step_look">STEP 02 · LOOK</string>
    <string name="setup_look_title">Choose a pack</string>
    <string name="setup_look_sub">Swaps the pack colour set. Each widget keeps one permanent colour.</string>
    <string name="setup_step_pack">STEP 03 · THE PACK</string>
    <string name="setup_pack_title">Pick your first widgets</string>
    <string name="setup_pack_sub">Eight widgets, one colour each. Start with two or three. The rest stay one tap away.</string>
    <string name="setup_step_access">STEP 04 · ACCESS</string>
    <string name="setup_access_title">Only what you picked</string>
    <string name="setup_access_sub">Say no and nothing breaks. Those widgets simply get vaguer, which suits some of them.</string>
    <string name="setup_access_footer">read on device · never uploaded</string>
    <string name="setup_access_none_title">Nothing to grant</string>
    <string name="setup_access_none_body">Everything you picked works out of the box. A rare and pleasant outcome.</string>
    <string name="setup_granted">granted</string>
    <string name="setup_step_home">STEP 05 · HOME</string>
    <string name="setup_home_title">Put them somewhere</string>
    <string name="setup_home_sub">We hand them to your launcher one at a time. If it would rather you did it yourself, long-press the home screen and choose Widgets.</string>
    <string name="setup_done_title">that\'s it.</string>
    <string name="setup_done_sub">Everything else lives in Settings, where you would expect it to be.</string>
