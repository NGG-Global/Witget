    <string name="onboarding_1_title">Information, interpreted</string>
    <string name="onboarding_1_body">Your phone already knows your battery level, your calendar and how long you have been staring at it. These widgets say something about it.</string>
    <string name="onboarding_2_title">Pick a voice</string>
    <string name="onboarding_2_body">Five personalities change what every widget says. You can set one globally and override it per widget.</string>
    <string name="onboarding_3_title">Permissions when you need them</string>
    <string name="onboarding_3_body">Five of the eight widgets need nothing at all. Screen Time, Day Vibe and Weather ask only when you add them, and everything else keeps working if you say no.</string>
    <string name="permission_usage_title">Usage access</string>
    <string name="permission_usage_body">Android keeps screen time behind a special permission that only Settings can grant. Soft Dread reads the daily total on this device and never sends it anywhere.</string>
    <string name="permission_usage_action">Open Settings</string>
    <string name="permission_calendar_title">Calendar access</string>
    <string name="permission_calendar_body">Day Vibe reads today\'s events to count meetings and booked hours. Titles stay on the device and are never shown unless you turn them on.</string>
    <string name="permission_calendar_action">Allow calendar</string>
    <string name="permission_location_title">Approximate location</string>
    <string name="permission_location_body">Weather can use your approximate location, or you can name a city instead and skip the permission entirely.</string>
