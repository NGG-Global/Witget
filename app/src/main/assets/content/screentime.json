            {
              "id": "ST_B6_DRY_02",
              "text": "Usage: {hours_short}. Human resources has been notified.",
              "vars": [
                "hours_short"
              ]
            },
            {
              "id": "ST_B6_DRY_03",
              "text": "{hours_short}. Your phone qualifies as a workplace.",
